# Copy this file to .env and fill in real values.
# cp .env.example .env   (macOS/Linux/Git Bash)
# copy .env.example .env (Windows CMD)

# --- Core / Security -----------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intervyou_db

# --- Redis -------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- LiveKit (WebRTC + Agents) -------------------------------------------
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecretsecret

# --- AI Interviewer voice pipeline (used by the LiveKit agent worker only) -
# Deepgram (STT):   https://console.deepgram.com
# OpenAI (LLM):     https://platform.openai.com
# ElevenLabs (TTS): https://elevenlabs.io
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVEN_API_KEY=

# --- Google Sign-In (optional) -------------------------------------------
# OAuth 2.0 "Web application" Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# --- Password-reset email (optional) --------------------------------------
# Leave all four blank to fall back to printing the reset link to the
# console (local development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- CORS ------------------------------------------------------------
# "*" for local development, or a comma-separated list of real origins
# in production, e.g.: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
