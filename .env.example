# Copy this file to .env and fill in real values.
# cp .env.example .env   (macOS/Linux/Git Bash)
# copy .env.example .env (Windows CMD)

# Generate one with: python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=

REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intervyou_db
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google Sign-In: OAuth 2.0 "Web application" Client ID from Google Cloud
# Console (APIs & Services -> Credentials). This MUST be the Web client
# (not Android/iOS) — it's the audience the Flutter app requests an
# id_token for AND the audience this backend checks the token against, so
# both sides have to use the exact same value or verification always
# fails. Leave empty and /auth/google returns 503, and GET
# /api/v1/auth/google/config reports "not configured", until this is set.
GOOGLE_CLIENT_ID=

# AI interviewer voice pipeline (used only by the separate LiveKit agent
# process: app/workers/livekit_agent.py).
# Deepgram (STT):   https://console.deepgram.com
# Rime (TTS):       https://rime.ai
# Simli (avatar):   https://app.simli.com/apikey, face_id from
#                   https://app.simli.com/create/from-existing
# OpenAI / ElevenLabs are alternate providers, unused unless
# STT_PROVIDER/LLM_PROVIDER/TTS_PROVIDER below is switched to them.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVEN_API_KEY=
RIME_API_KEY=
SIMLI_API_KEY=
SIMLI_FACE_ID=

# CV analysis & interview-question generation (DocumentAgent /
# QuestionnaireAgent, called from POST /api/v1/interviews/prepare).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Everything below has a working default; only set it to override ------
COOKIE_SECURE=false
STT_PROVIDER=deepgram
LLM_PROVIDER=gemma
TTS_PROVIDER=rime
LLM_MODEL=gpt-4o-mini

# Leave all four blank to fall back to printing the password-reset link to
# the console (local development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# "*" for local development, or a comma-separated list of real origins in
# production, e.g.: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=*
