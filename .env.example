# Google Sign-In: OAuth 2.0 "Web application" Client ID from Google Cloud
# Console (APIs & Services -> Credentials). This MUST be the Web client
# (not Android/iOS) — it's the audience the Flutter app requests an
# id_token for AND the audience this backend checks the token against, so
# both sides have to use the exact same value or verification always
# fails. Currently empty: /auth/google returns 503 and GET
# /api/v1/auth/google/config reports "not configured" until this is set.
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_EVAL_API_KEY=
# AI interviewer voice pipeline (used only by the separate LiveKit agent
# process: app/workers/livekit_agent.py). Get these from
# console.deepgram.com, platform.openai.com, and elevenlabs.io.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVEN_API_KEY=
RIME_API_KEY=
SIMLI_API_KEY=
SIMLI_FACE_ID=